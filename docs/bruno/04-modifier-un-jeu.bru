meta {
  name: Modifier un jeu
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/games/{{gameId}}
  body: json
  auth: none
}

body:json {
  {
    "title": "Outer Wilds: Echoes of the Eye",
    "editor": "Annapurna Interactive",
    "releaseYear": 2021,
    "genre": "Exploration",
    "rating": 9.6
  }
}

tests {
  test("Status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Titre modifié", function () {
    expect(res.getBody().title).to.equal("Outer Wilds: Echoes of the Eye");
  });
}
